<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_partner_warning" model="ir.ui.view">
        <field name="name">account.move.form.partner.warning</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" attrs="{'invisible': ['|', ('partner_invoice_warning', '=', False), ('state', '!=', 'draft')]}">
                    <field name="partner_invoice_warning" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
