<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_block_sale" model="ir.ui.view">
        <field name="name">product.template.form.block.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_line_warn_msg']" position="before">
                <field name="sale_line_block" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_block_purchase" model="ir.ui.view">
        <field name="name">product.template.form.block.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchase_line_warn_msg']" position="before">
                <field name="purchase_line_block" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
