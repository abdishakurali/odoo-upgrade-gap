<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hide.cost.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <app name="sale_management" position="inside">
                <block title="Cost Price Visibility" name="hcp_block">
                    <setting id="hcp_strict_mode_setting"
                             help="Cost price and margin are hidden from users without the 'Show Cost Price &amp; Margin' access. Strict also blocks them over the API.">
                        <field name="hcp_strict_mode"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
